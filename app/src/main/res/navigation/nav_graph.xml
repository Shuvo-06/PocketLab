<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.pocketlab.app.ui.dashboard.DashboardFragment"
        android:label="@string/nav_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/recorderFragment"
        android:name="com.pocketlab.app.ui.recorder.RecorderFragment"
        android:label="@string/nav_recorder"
        tools:layout="@layout/fragment_recorder" />

    <fragment
        android:id="@+id/experimentsFragment"
        android:name="com.pocketlab.app.ui.experiments.ExperimentsFragment"
        android:label="@string/nav_experiments"
        tools:layout="@layout/fragment_experiments" />

    <fragment
        android:id="@+id/experimentWizardFragment"
        android:name="com.pocketlab.app.ui.experiments.ExperimentWizardFragment"
        android:label="@string/nav_experiments"
        tools:layout="@layout/fragment_experiment_wizard" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.pocketlab.app.ui.history.HistoryFragment"
        android:label="@string/nav_history"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/sessionDetailFragment"
        android:name="com.pocketlab.app.ui.history.SessionDetailFragment"
        android:label="@string/nav_history"
        tools:layout="@layout/fragment_session_detail" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.pocketlab.app.ui.profile.ProfileFragment"
        android:label="@string/action_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/cloudFragment"
        android:name="com.pocketlab.app.ui.cloud.CloudFragment"
        android:label="@string/action_cloud"
        tools:layout="@layout/fragment_cloud" />
</navigation>
